    text: TWO BUILDINGS. NO BRIDGE. GET YOUR RUNNER ACROSS.
    hackerFace: neutral
  - speaker: 0
    speakerName: DASH
    time: 22:10
    text: NO BRIDGE? FINE. I'LL JUMP.
