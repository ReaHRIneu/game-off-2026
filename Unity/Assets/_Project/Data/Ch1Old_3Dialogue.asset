  briefing:
  - speaker: 0
    speakerName: BROKER
    time: 00:05
    text: A LASER HALL BLOCKS THE WAY OUT.
    hackerFace: neutral
  - speaker: 0
    speakerName: RUNNER
    time: 00:05
    text: I CAN DUCK. PROBABLY.
    hackerFace: joy
  - speaker: 1
    speakerName: 
    time: 00:06
    text: NO NEED. I'LL SWAP THE ROOMS.
    hackerFace: neutral
  ending:
  - speaker: 0
    speakerName: RUNNER
    time: 00:18
    text: THE WHOLE SHOP MOVED. WITH ME IN IT.
    hackerFace: surprise
  - speaker: 0
    speakerName: BROKER
    time: 00:18
    text: DONE. THE NIGHT ISN'T OVER.
    hackerFace: neutral
  - speaker: 1
    speakerName: 
    time: 00:19
    text: KEEP YOUR SHOES ON.
    hackerFace: neutral
