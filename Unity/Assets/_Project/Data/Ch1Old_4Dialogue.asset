  - speaker: 0
    speakerName: DASH
    time: 01:57
    text: WE DID IT! THE WHOLE TOWN, ROOM BY ROOM.
    hackerFace: joy
  - speaker: 0
    speakerName: DASH
    time: 01:57
    text: AND STILL NOT ONE REAL DOOR.
    hackerFace: joy
  - speaker: 0
    speakerName: X
    time: 01:58
    text: CLEAN WORK. NEXT TIME, OUT OF TOWN.
    hackerFace: neutral
