  briefing:
  - speaker: 0
    speakerName: X
    time: 01:40
    text: LAST JOB. ROOFTOP. LASERS, A CAMERA, NO STAIRS TO THE EXIT.
    hackerFace: neutral
  - speaker: 0
    speakerName: DASH
    time: 01:40
    text: SO... EVERYTHING AT ONCE.
    hackerFace: fear
  - speaker: 1
    speakerName: 
