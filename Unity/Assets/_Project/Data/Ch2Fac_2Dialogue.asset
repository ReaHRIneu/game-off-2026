  briefing:
  - speaker: 0
    speakerName: BROKER
    time: 22:40
    text: PACKING LINE. TWO PRESSES. ONE CAMERA.
    hackerFace: neutral
  - speaker: 0
    speakerName: RUNNER
    time: 22:40
    text: TWO HAMMERS. GREAT.
    hackerFace: fear
  - speaker: 1
    speakerName: 
    time: 22:41
    text: DON'T STOP IN FRONT OF THE CAMERA.
    hackerFace: anger
  ending:
  - speaker: 0
    speakerName: RUNNER
    time: 22:58
    text: WAIT. THESE CRATES HAVE A CITY PATROL MARK.
    hackerFace: surprise
  - speaker: 1
    speakerName: 
    time: 22:58
    text: NOT OUR JOB. MOVE.
    hackerFace: neutral
  - speaker: 0
    speakerName: BROKER
    time: 22:59
    text: GOOD. ONE MORE IN THIS FACTORY.
    hackerFace: neutral
