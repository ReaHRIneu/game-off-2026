  briefing:
  - speaker: 0
    speakerName: X
    time: 23:20
    text: CONTROL ROOM. TOP FLOOR. NO STAIRS LEAD THERE.
    hackerFace: neutral
  - speaker: 0
    speakerName: DASH
    time: 23:20
    text: LET ME GUESS. YOU MOVE A ROOM.
    hackerFace: joy
  - speaker: 1
    speakerName: 
    time: 23:21
    text: THE BEAT FIRST. THEN THE ROOM.
    hackerFace: neutral
  ending:
  - speaker: 0
    speakerName: DASH
    time: 23:39
    text: THOSE PATROL CRATES... SAME SQUAD THAT CHASED ME.
    hackerFace: fear
  - speaker: 1
    speakerName: 
    time: 23:39
    text: THEN WE KEEP LOOKING.
    hackerFace: neutral
  - speaker: 0
    speakerName: X
    time: 23:40
    text: CLEAN. I'LL CALL.
    hackerFace: neutral
